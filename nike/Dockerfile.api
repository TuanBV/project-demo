# use Python
FROM python:3.11-slim

# Install system build deps and update pip
RUN apt-get update && apt-get install -y \
    gcc \
    python3-dev \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --upgrade pip

# Setup folder work in container
WORKDIR /api

# Copy requirements.txt to container
COPY api/requirements.txt .

# Install package in requirements (pymysql is the declared, pinned DB driver)
RUN pip install --no-cache-dir -r requirements.txt

# Copy source to container (see .dockerignore: api/.env is excluded, never baked into the image)
COPY api /api

# Run uvicorn
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
