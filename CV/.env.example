# Copy this file to .env and adjust values for your machine.
# Never commit the real .env file.

# ---- PostgreSQL ----
DB_NAME=cvplatform
DB_USERNAME=cvplatform
DB_PASSWORD=cvplatform

# ---- MinIO (S3-compatible object storage, used from Phase 2 onward) ----
MINIO_ROOT_USER=cvplatform
MINIO_ROOT_PASSWORD=cvplatform-secret

# ---- Backend (Spring Boot) ----
# Must be a random string of at least 32 bytes in any real environment.
JWT_SECRET=local-dev-secret-change-me-local-dev-secret-32b
CORS_ALLOWED_ORIGINS=http://localhost:5174
PUBLIC_SITE_BASE_URL=http://localhost:5174

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:8082
